{
    "$schema": "vscode://schemas/settings/user",
    // ==================== Appearances ====================
    "workbench.experimental.modernUI": true,
    "editor.cursorBlinking": "solid",
    "workbench.colorTheme": "Edge Dark",
    "workbench.iconTheme": "material-icon-theme",
    "workbench.tree.indent": 16,
    "editor.fontFamily": "'Maple Mono NF CN', 'Source Han Sans SC', 'Consolas'",
    "editor.fontLigatures": true,
    "terminal.integrated.fontLigatures.enabled": true,
    // #if(os="windows")
    // "editor.fontSize": 12,
    // "terminal.integrated.fontSize": 12,
    // "debug.console.fontSize": 12,
    // "chat.fontSize": 12,
    // "chat.editor.fontSize": 12,
    // "markdown.preview.fontSize": 12,
    // #endif
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": [ "comment" ],
                "settings": {
                    "fontStyle": "bold"
                }
            }
        ]
    },
    "editor.semanticTokenColorCustomizations": {
        "enabled": true,
        "rules": {
            "*.mutable:rust": {
                "fontStyle": "italic underline"
            },

            // HACK(kazusa): highlight mutable variables in cpp
            "variable:cpp": {
                "fontStyle": "italic underline"
            },
            "variable.readonly:cpp": {
                "fontStyle": ""
            }
        }
    },

    // It's MyGO!!!!!
    "workbench.colorCustomizations": {
        "editor.wordHighlightBackground": "#3388BBa0",
        "editor.wordHighlightStrongBackground": "#3388BBa0"
    },
    "workbench.editor.showTabs": "single",
    "chat.commandCenter.enabled": false,
    "window.commandCenter": false,

    "diffEditor.hideUnchangedRegions.enabled": true,
    "diffEditor.renderSideBySide": false,
    "diffEditor.ignoreTrimWhitespace": true,
    "diffEditor.experimental.showMoves": true,

    // ==================== Features ====================
    "update.mode": "manual",
    "editor.detectIndentation": false,
    "editor.insertSpaces": true,
    "editor.tabSize": 4,
    "files.insertFinalNewline": true,
    "workbench.editor.enablePreview": false,

    "editor.quickSuggestions": {
        "other": "on",
        "comments": "on",
        "strings": "on"
    },

    "terminal.integrated.suggest.enabled": false,
    "terminal.integrated.initialHint": false,

    "git.autofetch": true,

    "debug.showVariableTypes": true,
    "debug.inlineValues": "auto",

    // ==================== Ext: Sync Settings ====================
    "syncSettings.resources": [
        "extensions",
        "keybindings",
        "settings",
        "snippets"
        // "uiState"
    ],

    // ==================== Ext: Vim ====================
    "vim.cursorStylePerMode.insert": "block",
    "vim.showMarksInGutter": true,
    "vim.showmodename": false,
    "vim.smartRelativeLine": false,
    "vim.statusBarColorControl": false,

    "vim.leader": "<space>",
    "vim.foldfix": true,
    "vim.hlsearch": true,

    "extensions.experimental.affinity": {
        "vscodevim.vim": 1
    },

    "vim.easymotion": true,

    "vim.normalModeKeyBindingsNonRecursive": [
        // { "before": [ "j" ], "after": [ "g", "j" ] , "silent": true },
        // { "before": [ "k" ], "after": [ "g", "k" ] , "silent": true },
        { "before": [ "o" ], "after": [ "o", "<esc>" ] , "silent": true },
        { "before": [ "X" ], "commands": [ ":bd" ], "silent": true },
        { "before": [ "<leader>" ,"x" ], "commands": [ "workbench.action.closeEditorsInGroup" ], "silent": true },
        { "before": [ "<c-p>" ], "commands": [ "workbench.action.quickOpen" ] , "silent": true },
        { "before": [ "<leader>", "a" ], "after": [ "`", "." ] , "silent": true },
        { "before": [ "<leader>", "s" ], "commands": [ ":ls" ] , "silent": true },
        { "before": [ "<leader>", "r" ], "commands": [ "workbench.action.tasks.runTask" ] , "silent": true },

        { "before": [ "[", "b" ], "commands": [ ":bprevious" ] , "silent": true },
        { "before": [ "]", "b" ], "commands": [ ":bnext" ] , "silent": true },
        { "before": [ "Y" ], "after": [ "\"", "+", "y" ] , "silent": true },

        { "before": [ "<c-h>" ], "commands": [ "workbench.action.focusLeftGroup" ] , "silent": true },
        { "before": [ "<c-l>" ], "commands": [ "workbench.action.focusRightGroup" ] , "silent": true },
        { "before": [ "<c-j>" ], "commands": [ "workbench.action.focusBelowGroup" ] , "silent": true },
        { "before": [ "<c-k>" ], "commands": [ "workbench.action.focusAboveGroup" ] , "silent": true },
        { "before": [ "<leader>", "|" ], "commands": [ "workbench.action.splitEditorRight" ] , "silent": true },
        { "before": [ "<leader>", "\\" ], "commands": [ "workbench.action.splitEditorDown" ] , "silent": true },
        { "before": [ "<leader>", "z" ], "commands": [ "workbench.action.toggleMaximizeEditorGroup" ] , "silent": true },

        { "before": [ "q", "q" ], "commands": [ "editor.action.commentLine" ] , "silent": true },
        { "before": [ "]", "d" ], "commands": [ "editor.action.marker.next" ] , "silent": true },
        { "before": [ "[", "d" ], "commands": [ "editor.action.marker.prev" ] , "silent": true },

        // git special
        { "before": [ "<leader>", "g", "r" ], "commands": [ "git.revertSelectedRanges" ] , "silent": true },
        { "before": [ "<leader>", "g", "d" ], "commands": [ "editor.action.dirtydiff.next" ] , "silent": true },
        { "before": [ "]", "g" ], "commands": [ "workbench.action.editor.nextChange" ] , "silent": true },
        { "before": [ "[", "g" ], "commands": [ "workbench.action.editor.previousChange" ] , "silent": true },

        // lsp special (gr family mirrors nvim builtin defaults: grr/grn/gra/gri/grt/grh)
        { "before": [ "g", "D" ], "commands": [ "editor.action.revealDefinitionAside" ] , "silent": true },
        { "before": [ "<leader>", "g", "q" ], "commands": [ "editor.action.format" ] , "silent": true },
        { "before": [ "g", "h" ], "commands": [ "editor.action.showHover" ] , "silent": true },
        { "before": [ "g", "o" ], "commands": [ "workbench.action.gotoSymbol" ] , "silent": true },
        { "before": [ "g", "r", "n" ], "commands": [ "editor.action.rename" ] , "silent": true },
        { "before": [ "g", "r", "a" ], "commands": [ "editor.action.codeAction" ] , "silent": true },
        { "before": [ "g", "r", "i" ], "commands": [ "editor.action.goToImplementation" ] , "silent": true },
        { "before": [ "g", "r", "t" ], "commands": [ "editor.action.goToTypeDefinition" ] , "silent": true },
        { "before": [ "g", "r", "r" ], "commands": [ "cCallHierarchyReferences.findReferences" ] , "silent": true },
        { "before": [ "g", "r", "h" ], "commands": [ "cCallHierarchyReferences.showHierarchy" ] , "silent": true },

        // extensions
        { "before": [ "<leader>", "m" ], "commands": [ "bookmarks.toggle" ] , "silent": true },
        { "before": [ "]", "t" ], "commands": [ "todo-tree.goToNext" ] , "silent": true },
        { "before": [ "[", "t" ], "commands": [ "todo-tree.goToPrevious" ] , "silent": true },
        { "before": [ "]", "q" ], "commands": [ "bookmarks.jumpToNext" ] , "silent": true },
        { "before": [ "[", "q" ], "commands": [ "bookmarks.jumpToPrevious" ] , "silent": true }


    ],
    "vim.normalModeKeyBindings": [
        { "before": [ "s" ], "after": [ "y", "s" ] , "silent": true },
        { "before": [ "f" ], "after": [ "<leader>", "<leader>", "s" ] , "silent": true }
    ],

    "vim.visualModeKeyBindingsNonRecursive": [
        { "before": [ "q" ], "commands": [ "editor.action.commentLine" ] , "silent": true },
        { "before": [ "<leader>", "g", "q" ], "commands": [ "editor.action.formatSelection" ] , "silent": true },
        { "before": [ "g", "r", "a" ], "commands": [ "editor.action.codeAction" ] , "silent": true }
        // { "before": [ "Y" ], "after": [ "\"", "+", "y" ] , "silent": true }
    ],

    "vim.visualModeKeyBindings": [
        { "before": [ "s" ], "after": [ "S" ] , "silent": true },
    ],

    "vim.handleKeys": {},

    // ==================== Ext: Bookmarks ====================
    "bookmarks.showCommandsInContextMenu": false,

    // ==================== Ext: Clangd ====================
    "clangd.arguments": [
        "--background-index",
        "--clang-tidy"
    ],

    // ==================== Ext: Error Lens ====================
    "errorLens.disableLineComments": {
        "clangd": "// NOLINT"
    },
    "errorLens.followCursor": "closestProblem",
    "errorLens.gutterIconSet": "circle",
    "errorLens.gutterIconsEnabled": true,

    // ==================== Ext: Outline Map  ====================
    "outline-map.customCSS": "* { font-size: 12px !important; }",


    // ==================== Ext: Git Lens  ====================
    "gitlens.plusFeatures.enabled": false,
    "gitlens.virtualRepositories.enabled": false,
    "gitlens.defaultGravatarsStyle": "robohash",
    "gitlens.statusBar.enabled": false,

    // ==================== Ext: Yaml  ====================
    "redhat.telemetry.enabled": false,

    // ==================== Ext: Todo Tree  ====================
    "todo-tree.general.showActivityBarBadge": true,
    "todo-tree.general.statusBar": "tags",
    "todo-tree.tree.expanded": true,
    "todo-tree.tree.groupedBySubTag": true,
    "todo-tree.tree.groupedByTag": true,
    "todo-tree.tree.flat": true,
    "todo-tree.tree.hideIconsWhenGroupedByTag": true,
    "todo-tree.tree.hideTreeWhenEmpty": true,
    "todo-tree.tree.showCountsInTree": true,
    "todo-tree.tree.buttons.groupBySubTag": true,
    "todo-tree.regex.regexCaseSensitive": false,
    "todo-tree.general.tags": [
        "ERR", "ERROR", "BUG", "ISSUE", "FIX", "FIXME",
        "WRN", "WARN", "WARNING", "NOTICE", "NOTE",
        "INF", "INFO", "PREF", "OPTIM",
        "HIT", "HINT", "DBG", "TODO"
    ],
    "todo-tree.general.tagGroups": {
        "ERR": ["ERR", "ERROR", "BUG", "ISSUE", "FIX", "FIXME"],
        "WRN": ["WRN", "WARN", "WARNING", "NOTICE", "NOTE"],
        "INF": ["INF", "INFO", "PREF", "OPTIM"],
        "HIT": ["HIT", "HINT", "DBG", "TODO"]
    },
    "todo-tree.highlights.customHighlight": {
        "ERR": { "background": "#ec7a79" },
        "WRN": { "background": "#deb974" },
        "INF": { "background": "#6cb6eb" },
        "HIT": { "background": "#a0c980" }
    },

    // ==================== Ext: Rust Analyzer  ====================
    "rust-analyzer.completion.fullFunctionSignatures.enable": true,
    "rust-analyzer.showDependenciesExplorer": false,
    "rust-analyzer.testExplorer": false,

    // ==================== Ext: Trailing Spaces  ====================
    "trailing-spaces.trimOnSave": true,

    // ==================== Ext: Cmake Tools  ====================
    "cmake.configureOnOpen": false,

    // ==================== Ext: Resource Monitor  ====================
    "resmon.show.battery": false,
    "resmon.show.cpufreq": false,

    // ==================== Ext: Go ====================
    "go.inlayHints.assignVariableTypes": true,
    "go.inlayHints.compositeLiteralFields": true,
    "go.inlayHints.compositeLiteralTypes": true,
    "go.inlayHints.constantValues": true,
    "go.inlayHints.functionTypeParameters": true,
    "go.inlayHints.ignoredError": true,
    "go.inlayHints.parameterNames": true,
    "go.inlayHints.rangeVariableTypes": true,
    "gopls": {
        "ui.semanticTokens": true
    }
}
